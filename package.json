        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/chrome": "^0.0.268",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "tailwindcss": "^4.0.0",
