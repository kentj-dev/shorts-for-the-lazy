{
    "manifest_version": 3,
    "name": "Shorts for the Lazy",
    "version": "1.1.0",
    "minimum_chrome_version": "114",
    "description": "Sit back and let YouTube Shorts advance automatically when each video ends.",
    "permissions": ["storage", "alarms"],
    "host_permissions": ["https://www.youtube.com/*"],
    "action": {
        "default_title": "Shorts for the Lazy",
        "default_popup": "popup/index.html",
        "default_icon": {
            "128": "images/logo.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "toggle-auto-scroll": {
            "suggested_key": {
                "default": "Alt+Shift+S",
                "mac": "Command+Shift+S"
            },
            "description": "Enable or disable YouTube Shorts auto-scroll (works in any tab)"
        }
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/down.svg",
                "images/pause.svg",
                "images/refresh.svg"
            ],
            "matches": ["https://www.youtube.com/*"]
        }
    ],
    "icons": {
        "128": "images/logo.png"
    }
}
